{
  "name": "phi-theme-studio",
  "private": true,
  "version": "0.1.0",
  "description": "GrapesJS-based visual theme pack editor for phi-plugin",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyh2011/phi-theme-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
